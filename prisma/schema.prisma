generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  username     String   @unique
  email        String   @unique
  displayName  String
  hunterRank   String   @default("E")  // E, D, C, B, A, S, SS, SSS, National, Monarch
  totalXp      Int      @default(0)
  currentLevel Int      @default(1)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quests            Quest[]
  questCompletions  QuestCompletion[]
  inventoryItems    InventoryItem[]
  shadowCompanions  ShadowCompanion[]
  streakLogs        StreakLog[]

  @@index([clerkId])
  @@index([username])
}

model Quest {
  id                String   @id @default(cuid())
  userId            String
  title             String
  description       String?
  attributeCategory String   // Strength, Agility, Intellect, Sense, Spirit
  verificationTier  Int      @default(1)  // 1=self-attest, 2=upload proof
  difficulty        String   @default("Normal")  // Easy, Normal, Hard, Extreme
  status            String   @default("active")  // active, completed, failed
  isDaily           Boolean  @default(false)
  xpReward          Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions      QuestCompletion[]

  @@index([userId])
  @@index([userId, status])
}

model QuestCompletion {
  id              String    @id @default(cuid())
  questId         String
  userId          String
  completedAt     DateTime  @default(now())
  proofUrl        String?
  verifiedBy      String    @default("self")  // self, upload, api
  xpAwarded       Int
  lootRollRarity  String?   // Common, Rare, Epic, Legendary, Mythic
  lootItemId      String?

  quest           Quest         @relation(fields: [questId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lootItem        InventoryItem? @relation(fields: [lootItemId], references: [id])

  @@index([userId])
  @@index([userId, completedAt])
}

model InventoryItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  rarity      String   // Common, Rare, Epic, Legendary, Mythic
  itemType    String   // Weapon, Armor, Accessory, Skill, Artifact
  equipped    Boolean  @default(false)
  iconEmoji   String   @default("⚔️")
  stats       Json?    // { strength: 5, agility: 3, etc. }
  acquiredAt  DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions QuestCompletion[]

  @@index([userId])
  @@index([userId, equipped])
}

model ShadowCompanion {
  id               String   @id @default(cuid())
  userId           String
  name             String
  title            String   // e.g. "Iron", "Knight", "Elite Knight"
  attributeAffinity String  // Strength, Agility, Intellect, Sense, Spirit
  level            Int      @default(1)
  state            String   @default("active")  // active, resting, weakened
  iconEmoji        String   @default("👤")
  description      String?
  unlockedAt       DateTime @default(now())
  lastActivityAt   DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StreakLog {
  id              String   @id @default(cuid())
  userId          String
  questCategory   String   // Strength, Agility, etc. or "overall"
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastCompletedAt DateTime?
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questCategory])
  @@index([userId])
}
